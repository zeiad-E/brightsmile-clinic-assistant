  "cards": [
    {
      "dot": "cyan",
      "title": "What each part does",
      "items": [
        "Chat turn: one turn at a time per chat; checks, privacy masking, saving",
        "Agent loop: asks the AI, runs the tools it asks for, checks the reply",
        "Reviewer: a second AI reads the reply before the patient does",
        "Tools: the only things the AI can do; they call the same services as the website"
      ]
    },
    {
      "dot": "rose",
      "title": "Safety rails",
      "items": [
        "Emergency words: a fixed reply and an urgent handover, the AI is skipped",
        "The AI never sees phones, emails, birth dates or codes: only [PHONE_1]-style labels",
        "Bookings and changes need the patient's yes in a later message (diagram 06)",
        "A reply with broken text, an unknown price or a fake 'done' is sent back"
      ]
    },
    {
      "dot": "amber",
      "title": "When the AI can't",
      "items": [
        "Busy: 8 turns at once, 50 waiting, 30 s at most in line",
        "5 failed turns in 5 min open the breaker for 3 min",
        "90 % of the daily clinic budget: safe mode, knowledge and handover only",
        "Two failed attempts: a fixed apology and a staff handover"
      ]
    },
    {
      "dot": "violet",
      "title": "Memory, in three layers",
      "items": [
        "Last 20 messages + a rolling summary of older ones",
        "Short notes about the patient (owner corrections win)",
        "Past chats: a summary + embedding each, recalled on demand",
        "Summaries and clean-ups run as background jobs (diagram 07)"
      ]
    }
  ]
}