  "cards": [
    { "dot": "cyan", "title": "Why a table, not memory", "items": [
      "A restart (deploy, free-plan sleep) would lose work kept in memory",
      "In Postgres, unfinished jobs simply run after the restart",
      "claim_jobs uses SKIP LOCKED: two runners never take the same job"
    ] },
    { "dot": "amber", "title": "Reminders, in two steps", "items": [
      "queue_reminders (every 15 min) marks due bookings and queues one send_reminder job each, in one transaction",
      "send_reminder emails one patient; a cancelled or moved booking is skipped",
      "It goes out about a day before the online change deadline (24 h by default)"
    ] },
    { "dot": "emerald", "title": "Waitlist", "items": [
      "join_waitlist (chat) saves a wish: service, maybe a doctor, a date range",
      "A cancel or move queues waitlist_slot_opened for the freed time",
      "The handler re-checks the time is free, then emails up to 5 waiting patients",
      "At most one email per wish every 12 hours; whoever books first gets it"
    ] },
    { "dot": "rose", "title": "Failures and safety net", "items": [
      "A failed job is retried after 1, 4, 9… minutes, up to its max attempts",
      "Every hour: jobs stuck in 'running' go back to the queue",
      "Nightly: chats past chat_retention_days are deleted, unless an escalation is open",
      "Embeddings for knowledge and chat summaries come from the LLM engine"
    ] }
  ]
