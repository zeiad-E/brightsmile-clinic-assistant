  "cards": [
    {
      "dot": "cyan",
      "title": "Checks first (no AI yet)",
      "items": [
        "Assistant paused by the owner, chat cooling down, or 60 turns used: fixed reply",
        "Emergency words: fixed reply + urgent handover, the AI is skipped",
        "A team member took over: the message waits for them",
        "Daily budget used or the breaker open: fixed reply with the clinic's phone"
      ]
    },
    {
      "dot": "emerald",
      "title": "AI + tools",
      "items": [
        "Phones, emails, birth dates and codes become [PHONE_1]-style placeholders",
        "System prompt + last 20 messages + this message",
        "Each tool round: the AI asks, the code checks the arguments and runs the tool",
        "At most 8 rounds and 60 s for the whole turn"
      ]
    },
    {
      "dot": "rose",
      "title": "Check the draft",
      "items": [
        "Broken text, a price the clinic doesn't have, or 'it's booked' with no confirm: sent back once",
        "Wrong language: sent back once",
        "Reviewer AI: may send it back up to 2 times",
        "Still objected to but sent: staff get a low-urgency alert"
      ]
    },
    {
      "dot": "amber",
      "title": "What each turn saves",
      "items": [
        "messages: the masked user text, tool calls, the reply",
        "conversations: state (pending action, placeholders), turn count, status",
        "agent_runs: one row (model, time, tools, outcome, tokens)",
        "agent_traces: every step, for debugging · then summary jobs are queued"
      ]
    }
