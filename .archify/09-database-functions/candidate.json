  "cards": [
    { "dot": "cyan", "title": "How to read it", "items": [
      "Left: the backend code (or table write) that uses a function",
      "Middle: the functions, grouped by job",
      "Right: the tables and views they read or change",
      "20 functions today; docs/07_DB_FUNCTIONS.md describes each one"
    ] },
    { "dot": "rose", "title": "Why logic lives in the database", "items": [
      "Booking checks and writes happen in one transaction: no double booking",
      "Every change to clinic data is audited, whoever made it",
      "Only the service role may run functions or touch tables; the public keys have no rights"
    ] },
    { "dot": "amber", "title": "Removed when sign-in moved to the backend", "items": [
      "verify_patient_by_phone, find_patient_by_code, normalize_person_name",
      "is_owner, is_staff, can_view_all, current_user_role (RLS role checks)",
      "handle_new_user / handle_deleted_user (the auth.users triggers)",
      "Who may do what is now decided in the backend (auth/permissions.js)"
    ] },
    { "dot": "emerald", "title": "The triggers", "items": [
      "set_updated_at on most tables · set_appointment_end from the service length",
      "reset_reminder_on_move: a moved booking gets a new reminder",
      "create_patient_profile: every new patient gets a profile",
      "audit_row_change on 10 clinic tables, actor from x-actor-id / x-change-via"
    ] }
  ]
