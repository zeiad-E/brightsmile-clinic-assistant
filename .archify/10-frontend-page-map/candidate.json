  "cards": [
    {
      "dot": "cyan",
      "title": "How the URLs work",
      "items": [
        "Every page lives under /en or /ar; proxy.js redirects / to your language (cookie, then browser)",
        "(site) and (team) are route groups: they pick the frame (header vs. sidebar) without adding to the URL",
        "Public pages are built on the server; account and team pages load their data in the browser after sign-in"
      ]
    },
    {
      "dot": "rose",
      "title": "Who can open what",
      "items": [
        "Anyone: the public pages, /book and /assistant (the chat works for guests)",
        "/account/*: signed-in patients",
        "/dashboard/*: staff, owner and the read-only demo viewer",
        "/owner/*: the owner; the viewer sees it with personal data masked; staff are sent back"
      ]
    },
    {
      "dot": "amber",
      "title": "The buttons are not the lock",
      "items": [
        "The frontend only hides what you may not use (it reads permissions from /api/auth/me)",
        "The real check is requirePermission on every backend route (diagram 03)"
      ]
    }
  ]
