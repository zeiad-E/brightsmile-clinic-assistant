  "cards": [
    {
      "dot": "rose",
      "title": "Why two turns",
      "items": [
        "The AI can only prepare a booking; the code books it",
        "The yes must arrive in a later message than the proposal",
        "A reply saying 'booked' with no successful confirm is sent back (diagram 05)"
      ]
    },
    {
      "dot": "emerald",
      "title": "Race-safe in the database",
      "items": [
        "book_appointment checks the slot and inserts in one transaction",
        "Exclusion constraints: no doctor or patient can be double-booked",
        "The second person gets 409 slot_taken with the next free times"
      ]
    },
    {
      "dot": "cyan",
      "title": "Who gets signed in",
      "items": [
        "A guest who becomes a new patient: signed in at once (method 'booking')",
        "A guest matching an existing patient: booked, but not signed in",
        "The browser swaps the ticket at POST /auth/ticket for its own cookie (diagram 03)"
      ]
    },
    {
      "dot": "amber",
      "title": "Same rules on the website",
      "items": [
        "POST /api/appointments calls the same bookAsVisitor",
        "The browser sends its own Idempotency-Key header",
        "Cancel and reschedule follow the same propose → confirm pattern in the chat"
      ]
    }
  ]
