  "cards": [
    {
      "dot": "cyan",
      "title": "Two keys, kept apart",
      "items": [
        "Access token: a 15-minute pass, kept only in the tab's memory",
        "Refresh token: in an HttpOnly cookie that page scripts can't read",
        "Changing JWT_SECRET only makes browsers refresh: sessions live in the database"
      ]
    },
    {
      "dot": "emerald",
      "title": "Every way in",
      "items": [
        "Team (owner, staff, viewer): email + password (+ the read-only demo button)",
        "Patients: emailed code, phone + name + date of birth, or personal code",
        "Also: sign-up, booking as a new patient, or signing in inside the chat",
        "sessions.issue refuses a method that doesn't fit the role"
      ]
    },
    {
      "dot": "violet",
      "title": "The chat can't set a cookie",
      "items": [
        "A sign-in inside the chat makes a session with a 2-minute ticket",
        "The browser swaps it at POST /auth/ticket for the normal cookie",
        "The guest's chats (visitor cookie bs_vid) then move to the account"
      ]
    },
    {
      "dot": "amber",
      "title": "How long a session lasts",
      "items": [
        "patient: 7 days idle · 30 days at most",
        "staff and owner: 12 hours idle · 7 days at most",
        "viewer (demo): 2 hours idle · 1 day at most"
      ]
    }
  ]
