  "cards": [
    { "dot": "cyan", "title": "How a page reaches the backend", "items": [
      "The browser only talks to the website, so there is no cross-site (CORS) problem",
      "Next.js forwards every /api/* call to the Render backend (rewrite)",
      "proxy.js adds the visitor's real IP, proved by PROXY_SHARED_SECRET",
      "Server-rendered pages call the backend directly for public data"
    ] },
    { "dot": "emerald", "title": "One Render box, two programs", "items": [
      "start.sh launches the LLM engine first, then the backend",
      "The engine listens on 127.0.0.1:3001: the internet can't reach it",
      "If either program stops, the whole container restarts",
      "The job runner (reminders, waitlist, clean-up) lives inside the backend"
    ] },
    { "dot": "rose", "title": "Who holds the keys", "items": [
      "Only the backend talks to Supabase, with the service role key",
      "Supabase Auth is no longer used: sign-in lives in the backend (diagram 03)",
      "Secrets are Render / Vercel settings, never in the code"
    ] },
    { "dot": "amber", "title": "Free-plan facts", "items": [
      "Render sleeps after 15 min idle, so keep-warm pings /health every 10 min",
      "A push touching backend/** or infra/render/** rebuilds the Render service",
      "Email goes through Brevo's HTTPS API: Render's free plan blocks SMTP ports",
      "Owner extra: /__llm-admin?key=… opens the engine dashboard (off without a key)"
    ] }
  ]
