# ---- Server ----
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ---- LLM engine (freellmapi, self-hosted OpenAI-compatible /v1) ----
LLM_ENGINE_BASE_URL=http://localhost:3001/v1
LLM_ENGINE_API_KEY=your_unified_engine_token
LLM_DEFAULT_MODEL=auto
# Ordered chat chain (tried in order on error/timeout), chosen by benchmark
LLM_CHAT_MODELS=gpt-oss-120b,qwen3.8-27b,command-a-2,gemini-3.5-flash-lite,auto
LLM_CHAT_TIMEOUT_MS=20000
LLM_EMBEDDING_MODEL=gemini-embedding-001
LLM_EMBEDDING_DIMENSIONS=768
# Engine admin login, used to fetch the unified key at boot when LLM_ENGINE_API_KEY is empty.
# In the Render container these come from FREEAPI_CONFIG_JSON (.admin) instead.
ENGINE_ADMIN_EMAIL=
ENGINE_ADMIN_PASSWORD=
FREEAPI_CONFIG_JSON=
# Secret key for the hidden engine dashboard door (/__llm-admin?key=...); empty disables it. Min 24 chars.
LLM_ADMIN_DOOR_KEY=

# ---- Fallback provider (used if the engine is unreachable/throttled) ----
FALLBACK_PROVIDER_BASE_URL=https://api.groq.com/openai/v1
FALLBACK_PROVIDER_API_KEY=your_groq_key
FALLBACK_MODEL=llama-3.3-70b-versatile

# ---- Supabase (Postgres + pgvector + Auth) ----
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_ANON_KEY=your_anon_key

# ---- Sign-in ----
# Fingerprints personal sign-in codes. Required in production (min 32 chars), e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it invalidates every code already emailed.
PERSONAL_CODE_SECRET=
# The frontend address, used in email links.
APP_URL=http://localhost:3000

# ---- Email ----
# log = print to the console only · smtp = Gmail (App Password) · brevo = Brevo HTTPS API
EMAIL_PROVIDER=log
MAIL_FROM=BrightSmile Dental <your.clinic@gmail.com>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
BREVO_API_KEY=

# ---- Agent limits ----
AGENT_MAX_TOOL_ITERATIONS=5
AGENT_TURN_TIMEOUT_MS=30000

# ---- Agent evals (npm run eval:agent) ----
# The eval pass: the same value here and on Render. Min 32 chars; empty disables it, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
EVAL_KEY=
# Where the evals send their conversations (the live API by default).
EVAL_API_URL=https://brightsmile-api-3si7.onrender.com
