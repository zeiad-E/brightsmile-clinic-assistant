# Copy to .env (never commit .env).

# 64 hex chars (AES-256-GCM key for stored provider keys). Keep it stable:
# changing it makes every stored key undecryptable.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Check tool-call arguments against the declared schema; fail over on violations.
VALIDATE_TOOL_ARGUMENTS=1

# Exact-match response cache (saves provider quota on identical requests).
RESPONSE_CACHE=true
RESPONSE_CACHE_TTL_SECONDS=3600

# Max /v1 requests per minute per client IP.
PROXY_RATE_LIMIT_RPM=120
